# Copia este archivo como .env.properties (misma carpeta que pom.xml) y pon TUS valores.
# .env.properties está en .gitignore: nunca se sube a GitHub. Este .ejemplo sí se sube, sin claves reales.
DB_USUARIO=nutrisalud_app
DB_CLAVE=escribe_aqui_tu_clave
# genera uno propio (PowerShell): [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
NUTRISALUD_JWT_SECRETO=pega_aqui_tu_secreto_base64
# usuario de práctica que usan las pruebas de integración (PacienteIntegracionTest)
CORREO_ENFERMERA=enfermera@posta.pe
CLAVE_ENFERMERA=escribe_aqui_la_clave_de_la_enfermera
